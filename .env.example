# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_USER=icga
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=icga
DATABASE_URL=postgres://icga:replace-with-a-long-random-password@db:5432/icga
PORT=5000
SESSION_SECRET=replace-with-a-long-random-secret

# Clerk. Leave blank only for a local smoke test of the calendar.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Optional. Required only if GitHub webhooks are enabled.
GITHUB_WEBHOOK_SECRET=

# Replit autodeploy uses GitHub environment secrets, not this file.
# Production environment: REPLIT_REPL_ID and REPLIT_DEPLOY_TOKEN
